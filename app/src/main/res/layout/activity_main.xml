<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo">

    <!-- Topo: trabalho, GNSS, Ligar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/boxJob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Trabalho"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="projecto"
                android:textColor="@color/texto"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGnss"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="GNSS ▾"
            android:textColor="@color/verde"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnLigar"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Ligar"
            android:textColor="@color/texto"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bastão, IMU, Laser, Câmara, Configurar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvPole"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="2.00 m"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnTilt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_red_box"
            android:gravity="center"
            android:text="⟋"
            android:textColor="@color/vermelho"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnLaser"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_box"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Laser"
            android:textColor="@color/cinza"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnCamera"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Câmara"
            android:textColor="@color/cinza"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnConfig"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:text="Configurar"
            android:textColor="@color/verde"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liga o GNSS"
                android:textColor="@color/vermelho"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idade RTK: —"
                android:textColor="@color/vermelho"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvImu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardar IMU"
                android:textColor="@color/vermelho"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bat. — · Guardado ✓"
                android:textColor="@color/texto"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/tvEnz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="TM06  E — · N — · Z —"
        android:textColor="@color/texto"
        android:textSize="14sp" />

    <!-- Mapa -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_map"
        android:clipToOutline="true">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnSeguir"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_map_btn"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Seguir ○"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnExtent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_map_btn"
                android:gravity="center"
                android:text="↗"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnMapMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_map_btn"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/texto"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCenter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="52dp"
            android:background="@drawable/bg_map_btn"
            android:gravity="center"
            android:text="⌖"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnMapa"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="50dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Mapa ▾"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_footer"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPronto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F2FFFFFF"
                android:maxWidth="220dp"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:text="Pronto"
                android:textColor="@color/texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAttrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="4dp"
                android:text="DGT · OrtoSat 2023 | BUPi · RGG públicas"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Códigos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/texto"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Ponto, descrição, Medir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="78dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_box"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Ponto"
                android:textColor="#616161"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPonto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="text"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:text="1"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="Descrição"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="19sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAddCode"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/verde"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMedir"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Medir"
            android:textColor="@color/texto"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnMedirPlus"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Medir +"
            android:textColor="#757575"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Navegação inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navMedir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navMedirIcon"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_on"
                android:gravity="center"
                android:text="⌖"
                android:textColor="@color/texto"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medir"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navImplantar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navImplantarIcon"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⚑"
                android:textColor="@color/texto"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Implantar"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="◿"
                android:textColor="@color/texto"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COGO"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOpcoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/texto"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opções"
                android:textColor="@color/texto"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
